# Copy to .env.local for local Vite without Doppler, or store in Doppler.
# Vite only exposes VITE_* to the browser; vite.config maps the aliases below.

# Preferred (Vite-native)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Doppler / GitHub github-pages environment names (also accepted):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
