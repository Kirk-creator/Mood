# Copy to .env.local for local Vite without Doppler, or store in Doppler.
# Vite only exposes VITE_* to the browser; vite.config maps the aliases below.

# Preferred (Vite-native)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Also accepted via Doppler / process env (mapped in vite.config.ts):
# SUPABASE_URL=
# SUPABASE_ANON=
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_ANON=
